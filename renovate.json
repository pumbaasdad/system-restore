{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  "timezone": "America/Toronto",
  "prHourlyLimit": 10,
  "dependencyDashboard": false,

  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/^roles/[^/]+/vars/packages/(ubuntu|debian)(?:\\.yml|_[^/]+\\.yml)$/"
      ],
      "matchStrings": [
        "$.*.apt[$not($exists(repology))].( $each(packages, function($version, $package) { { \"depName\": $package, \"currentValue\": $version, \"registryUrl\": repository & \"?suite=\" & distribution & \"&components=\" & $join(components, \",\") & \"&binaryArch=\" & arch } }) )"
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    },
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/^roles/[^/]+/vars/packages/(ubuntu|debian)(?:\\.yml|_[^/]+\\.yml)$/"
      ],
      "matchStrings": [
        "$.*.apt[repology].( $each(packages, function($version, $package) { { \"depName\": repology & \"/\" & name, \"currentValue\": $version } }) )"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "deb"
    }
  ],

  "packageRules": [
    {
      "description": "MongoDB packages",
      "matchPackagePatterns": ["^mongodb-"],
      "groupName": "mongodb packages"
    },
    {
      "description": "Docker packages",
      "matchPackagePatterns": [
        "^docker-",
        "^containerd\\.io$"
      ],
      "groupName": "docker packages"
    }
  ]
}





