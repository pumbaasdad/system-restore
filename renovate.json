{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],

  "timezone": "America/Toronto",
  "schedule": ["* 0-4 * * 6"],
  "prHourlyLimit": 10,
  "dependencyDashboard": false,

  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/^roles/[^/]+/vars/packages/ubuntu(?:\\.yml|_[^/]+\\.yml)$/"
      ],
      "matchStrings": [
        "$.*.apt.( $each(packages, function($version, $package) { { \"depName\": $package, \"currentValue\": $version, \"repository\": repository, \"arch\": arch, \"components\": $join(components, \",\"), \"distribution\": distribution } }) )"
      ],
      "registryUrlTemplate": "{{ repository }}?suite={{ distribution }}&components={{ components }}&binaryArch={{ arch }}",
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    }
  ],

  "packageRules": [
    {
      "description": "MongoDB packages",
      "matchPackagePatterns": ["^mongodb-"],
      "groupName": "mongodb packages"
    },
    {
      "description": "Docker packages",
      "matchPackagePatterns": [
        "^docker-",
        "^containerd\\.io$"
      ],
      "groupName": "docker packages"
    }
  ]
}





