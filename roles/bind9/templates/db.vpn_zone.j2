{%- import 'db/macros.j2' as macros -%}
{%- set records = [] -%}
{%- for zone in bind9_vpn_zones -%}
    {%- for record in macros.append_records_for_zone(zone, bind9_zone, bind9_root_domain) %}
        {%- set _ = records.append(record) -%}
    {%- endfor -%}
{%- endfor -%}
{%- set records = records | selectattr('vpn', 'equalto', true) -%}
{%- set record_selector = { 'field': 'type', 'test': 'equalto', 'value': 'CNAME' } -%}
{%- set hostnames = (records | selectattr(record_selector.field, record_selector.test, record_selector.value) | map(attribute='host') | map('string'))  + [bind9_server] -%}
{%- set max_pad = macros.get_max_padding(hostnames) | int -%}
{%- set ns_record = {'host': bind9_server, 'type': 'A', 'target_host': bind9_host_ip, 'target_zone': ''}  -%}
{%- set origin_subdomain = ((zone_name == bind9_root_domain) | ternary('', 'vpn')) -%}
{{ macros.print_file(zone_name, bind9_hostname, bind9_root_domain, records, record_selector, zone_serial_number, '', origin_subdomain, max_pad)  }}
{%- if zone_name == bind9_root_domain -%}

{{ macros.print_ttl(1, 'week') }}
{{ macros.print_record(ns_record, max_pad) }}
{%- endif -%}