#!/bin/bash

DEPENDENCY_HOST="{{ virtual_machine_dependency_address }}"
NFS_EXPORT="{{ virtual_machine_dependency_mount }}"
CHECK_INTERVAL=1   # Check interval in seconds
TIMEOUT=3          # Ping timeout in seconds

# Logging function
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [HOOK] $1" | logger -t "proxmox-hook"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [HOOK] $1"
}

# Check that the server is responding and lists the expected export
check_nfs() {
    timeout "$TIMEOUT" showmount -e "$DEPENDENCY_HOST" 2>/dev/null \
        | awk -v export="$NFS_EXPORT" 'NR>1 && $1==export {found=1} END {exit !found}'
}

wait_for_nfs() {
    local elapsed=0
    log_message "Waiting for export $NFS_EXPORT on $DEPENDENCY_HOST..."

    while true; do
        if check_nfs; then
            log_message "Export $NFS_EXPORT on $DEPENDENCY_HOST is available after ${elapsed}s. Proceeding."
            return 0
        fi

        log_message "Export not available yet. Retrying in ${CHECK_INTERVAL}s... (${elapsed}s elapsed)"
        sleep "$CHECK_INTERVAL"
        elapsed=$((elapsed + CHECK_INTERVAL + TIMEOUT))
    done
}

# Main hook logic
case "$2" in
    pre-start)
        log_message "Pre-start hook triggered for $2 (VMID: $3)"

        wait_for_nfs;

        log_message "Dependency check passed for $2 (VMID: $3)"
        exit 0
        ;;
    post-start)
        log_message "Post-start hook: $2 (VMID: $3) started successfully"
        exit 0
        ;;
    pre-stop)
        log_message "Pre-stop hook: $2 (VMID: $3) stopping"
        exit 0
        ;;
    post-stop)
        log_message "Post-stop hook: $2 (VMID: $3) stopped"
        exit 0
        ;;
    *)
        log_message "Unknown hook phase: $1"
        exit 0
        ;;
esac